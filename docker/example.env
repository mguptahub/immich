# You can find documentation for all the supported env variables at https://docs.immich.app/install/environment-variables

# The location where your uploaded files are stored
UPLOAD_LOCATION=./library

# To store uploaded photos/videos, thumbnails, encoded video, profile images and
# database backups in an S3 bucket instead of the UPLOAD_LOCATION volume, uncomment
# the lines below. UPLOAD_LOCATION/the volume mount is still required (it becomes a
# small, mostly-empty local directory) but is no longer where your media lives.
# STORAGE_PROVIDER=s3
# S3_BUCKET=my-immich-bucket
# S3_REGION=us-east-1
# Only needed for S3-compatible services (MinIO, Backblaze B2, Cloudflare R2, etc.)
# S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Set to true for most non-AWS S3-compatible services (e.g. MinIO)
# S3_FORCE_PATH_STYLE=false
# Optional prefix to namespace objects within the bucket
# S3_KEY_PREFIX=

# Local MinIO (dev): matches the optional `minio` service in docker-compose.dev.yml.
# Start it alongside the rest of the stack with:
#   docker compose -f docker-compose.dev.yml --profile s3 up
# then uncomment these (together with STORAGE_PROVIDER=s3 above) instead of the generic
# S3_* block above.
# S3_BUCKET=immich
# S3_ENDPOINT=http://minio:9000
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin
# S3_FORCE_PATH_STYLE=true

# The location where your database files are stored. Network shares are not supported for the database
DB_DATA_LOCATION=./postgres

# To set a timezone, uncomment the next line and change Etc/UTC to a TZ identifier from this list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones#List
# TZ=Etc/UTC

# The Immich version to use. You can pin this to a specific version like "v2.1.0"
IMMICH_VERSION=v3

# Only used by docker-compose.prod.yml, which runs this fork's own published
# immich-server image (built by .github/workflows/build-docker.yml) instead of
# building from source. Defaults to `latest` (tracks the production branch);
# pin to a specific build instead by setting e.g. sha-abc1234 or v1.2.3.
# IMMICH_SERVER_IMAGE_TAG=latest

# Connection secret for postgres. You should change it to a random password
# Please use only the characters `A-Za-z0-9`, without special characters or spaces
DB_PASSWORD=postgres

# The values below this line do not need to be changed
###################################################################################
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
